#
# Recovery-only sepolicy file_contexts. Add device-specific HAL binaries and
# state paths here. The reference dali tree labels the crypto HAL chain under
# /vendor and the ramdisk module closure under /lib/modules.
#
# Use platform-defined type names (persist_data_file, storage_file,
# media_rw_data_file, ...) — do NOT invent new types that collide with platform
# policy. Device-specific types belong in pd2415_*.te with unique names.

# PD2415 has no /vendor/bin/tee-supplicant; TEE is Trustonic.
/vendor/bin/hw/vendor.trustonic.tee-service u:object_r:pd2415_tee_exec:s0
/vendor/bin/hw/vendor.gatekeeper-.*   u:object_r:hal_gatekeeper_default_exec:s0
/vendor/bin/hw/vendor.keymint-.*      u:object_r:hal_keymint_default_exec:s0
/vendor/bin/hw/vendor.secure_element-.* u:object_r:hal_secure_element_default_exec:s0

/mnt/vendor/persist(/.*)?             u:object_r:persist_data_file:s0
/lib/modules(/.*)?                    u:object_r:recovery_modules_file:s0
/storage(/.*)?                        u:object_r:storage_file:s0
/mnt/media_rw(/.*)?                   u:object_r:media_rw_data_file:s0
# Label device-specific TEE state paths here (example from dali):
# /mnt/vendor/persist/MITEE(/.*)?     u:object_r:pd2415_mitee_data_file:s0
# /data/vendor/mitee(/.*)?            u:object_r:pd2415_mitee_data_file:s0
