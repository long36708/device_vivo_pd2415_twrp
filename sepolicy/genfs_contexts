#
# genfs_contexts for the recovery ramdisk. Label the module tree and persist so
# recovery's insmod / tee loaders run with the right type.

genfscon sysfs /devices/platform/soc/mt6991-.*   u:object_r:sysfs_soc:s0
genfscon proc  /driver/                          u:object_r:proc_driver:s0
