#
# SoC-specific early init for MT6991 (MediaTek Dimensity 9400). Same SoC as
# dali; recovery-specific tuneables go here; device HAL/crypto logic belongs
# in init.recovery.project.rc.
#
# of.skip_vendor_module_mount / of.skip_format_pending_merge are set in
# init.recovery.project.rc (on early-init); do NOT repeat them here.

import /init.recovery.project.rc

on init
    # MediaTek MT6991 USB controller + configfs
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "16701000.usb0"
    # Stock init.mt6991.usb.rc sets both; some UDC writes use
    # ${vendor.usb.controller} instead of ${sys.usb.controller}.
    setprop vendor.usb.controller "16701000.usb0"
    # Stock init.mt6991.usb.rc also sets these; USB gadget setup
    # in on post-fs references ${vendor.usb.vid} for idVendor.
    setprop vendor.usb.vid "0x0E8D"
    # ACM serial ports (modem) — not used in recovery but set
    # defaults to avoid undefined-property issues in vendor USB rc.
    setprop vendor.usb.acm_cnt 0
    setprop vendor.usb.acm_port0 ""
    setprop vendor.usb.acm_port1 ""
    setprop vendor.usb.acm_enable 0
    # servicemanager is class core but recovery init.rc may not call
    # class_start core; start explicitly so servicemanager.ready=true
    # is published and clients (adbd, keystore2) can proceed.
    start servicemanager

on fs
    # Load vendor kernel modules before USB init.  In vendor_boot v4
    # recovery, init first stage does not modprobe /lib/modules, and
    # the recovery binary loads them too late (after USB gadget init
    # has already failed due to missing UDC driver).  Load them here
    # so the USB controller (mtu3) and host controller (xhci-mtk-hcd-v2)
    # are registered before the sys.usb.configfs triggers fire.
    exec u:r:recovery:s0 root -- sh -c 'for m in $$(sort /lib/modules/modules.dep | sed "s/:.*//"); do insmod /lib/modules/$$m 2>/dev/null; done'

on fs && property:ro.debuggable=0
    # SoC-specific fs hooks (e.g. charging-free USB detection) go here.

on boot
    # SoC utilities (MediaTek: mtk_plpath_utils). Copy the structure
    # from the reference init.recovery.mt6991.rc and adjust the binary name.
    #   exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils

# Optional early SoC service definitions (thermal, disp, etc.) go here.
