#
# Persist partition mount for recovery. Do NOT mark formattable: recovery needs
# the existing calibration / TEE state on persist.

/dev/block/by-name/persist /mnt/vendor/persist ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check
