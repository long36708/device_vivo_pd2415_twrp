#
# Device/project init for vivo X200 Pro mini (pd2415). The reference dali tree
# wires the crypto HAL chain (tee-supplicant, keymint, gatekeeper, weaver,
# secure_element) and TEE state here. Replace the helper scripts and service
# names with those of the target device; the skeleton below is generic.

on early-init
    # Modules live in the recovery ramdisk; keep the ramdisk HAL closure visible
    # and correctly labelled until manual mounts are requested.
    setprop of.skip_vendor_module_mount 1
    setprop of.skip_format_pending_merge 1
    stop keystore2
    mkdir /odm 0755 root root
    mkdir /usb_otg 0755 root root
    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/persist 0755 root root
    # NOTE: do NOT mount persist here.  At early-init the /dev/block/by-name
    # nodes don't exist yet (ueventd hasn't coldbooted): mount_all --early
    # waited 20s, logged "Skipping /dev/block/by-name/persist during
    # mount_all", and delayed the whole boot by 20s.  Persist is mounted in
    # the init.svc.recovery=running trigger below (stock
    # init.recovery.platform.rc does the same explicit mount).

on property:servicemanager.ready=true
    # Start device boot-control HAL if present.
    # start vendor.boot-default

on property:twrp.modules.loaded=true
    # Hook for device-specific runtime setup after modules load.
    trigger pd2415_vendor_runtime

on pd2415_vendor_runtime
    restorecon_recursive /system/bin
    restorecon_recursive /system/lib64
    restorecon_recursive /system/etc
    # Label the ramdisk vendor/odm HAL closure before starting HALs.
    restorecon_recursive /vendor/bin
    restorecon_recursive /vendor/lib64
    restorecon_recursive /odm
    # Reference (dali): set the crypto SPL ceiling synchronously from the
    # installed system so KeyMint accepts upgraded FBE blobs after an OTA.
    #   exec u:r:recovery:s0 -- /system/bin/pd2415-spl-override.sh
    #   exec u:r:recovery:s0 -- /system/bin/pd2415-ensure-tee.sh

# --- crypto HAL chain (Trustonic Kinibi TEE for PD2415) ---------------------
# Two layers, mirroring the stock recovery (trustonic.rc):
#   1. mobicore = mcDriverDaemon, the Kinibi TEE supervisor daemon.  It needs
#      mcDrvModule-ffa.ko (loaded by load-modules.sh before the
#      pd2415_vendor_runtime trigger) and publishes
#      ro.vendor.trustonic.ready=true once mcOpenSession works.
#   2. The HALs (keymint / gatekeeper / tee-service), started only after the
#      daemon is ready.  keystore2 is already running (its own rc) and its
#      retry loop connects to keymint as soon as it registers.
# Everything runs in the recovery domain via seclabel: the OrangeFox recovery
# policy is permissive, so no per-HAL vendor allow rules are required, and
# this avoids the exec_type/data_file_type neverallow traps entirely.
service mobicore /system/bin/start-mobicore.sh
    user root
    group system
    disabled
    seclabel u:r:recovery:s0
    # NOTE 1: no 'priority -20' — the init child drops CAP_SYS_NICE, so
    # setpriority(-20) aborts the service (status 6) before the script runs.
    # NOTE 2: user root, not system — the built-in Kinibi driver's
    # /dev/mobicore node comes up root:root 0600 (our ueventd rule may not
    # apply in time), and a `system` daemon then fails open() silently.

service vendor.trustonic.tee /vendor/bin/hw/vendor.trustonic.tee-service
    user system
    group system
    disabled
    seclabel u:r:recovery:s0

service vendor.keymint-trustonic /vendor/bin/hw/android.hardware.security.keymint@3.0-service.trustonic
    user system
    group system
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper-trustonic /vendor/bin/hw/android.hardware.gatekeeper-service.trustonic
    user system
    group system
    disabled
    seclabel u:r:recovery:s0

on property:ro.vendor.trustonic.ready=true
    start vendor.trustonic.tee
    start vendor.keymint-trustonic
    start vendor.gatekeeper-trustonic

on property:orangefox.postinit.status=1
    # Detach logical vendor/odm mounts OrangeFox may have created so they are
    # free for OTA snapshot handling.

on property:init.svc.recovery=running
    # Recovery entry point; device-specific late hooks go here.
    # Mount persist explicitly.  'mount ext4 /dev/block/by-name/persist'
    # fails here ("Can't lookup blockdev"): by-name symlinks are only made
    # for fstab-listed partitions and ours lacks persist.  The helper scans
    # /sys/class/block for PARTNAME=persist instead.
    exec u:r:recovery:s0 root -- /system/bin/mount-persist.sh
    mkdir /mnt/vendor/persist/mcRegistry 0771 system system
    restorecon_recursive /mnt/vendor/persist
    # Keep TWRP's own boot log (/tmp/recovery.log, tmpfs) synced to the
    # persist partition: when the UI never comes up and the device
    # auto-reboots, this is the only way to recover the recovery log and
    # see where the binary hung.
    start recovery_log_sync
    # Bring up the Kinibi daemon (its script waits for /dev/mobicore, which
    # load-modules.sh creates during on-fs).  mcDriverDaemon sets
    # ro.vendor.trustonic.ready=true when done, which starts the
    # keymint/gatekeeper HALs above; keystore2's retry loop then connects.
    start mobicore

service recovery_log_sync /system/bin/sh /system/bin/log-sync.sh
    user root
    seclabel u:r:recovery:s0
    disabled
