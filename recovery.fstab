# Recovery-only partition inventory derived from the official recovery fstab
# (extract-official-prebuilts.sh installs the official baseline; curate it like
# device_xiaomi_dali_twrp/recovery.fstab). The complete official first-stage
# fstab stays in first_stage_ramdisk/ for Android init; do not expose raw
# boot-chain, modem, or firmware partitions to Recovery's PartitionManager.

# Dynamic partitions required for Recovery mounts and ROM workflows
# (keep the paired erofs/ext4 lines).
system      /system      erofs ro wait,slotselect,logical,first_stage_mount
system      /system      ext4  ro wait,slotselect,logical,first_stage_mount
system_ext  /system_ext  erofs ro wait,slotselect,logical,first_stage_mount
system_ext  /system_ext  ext4  ro wait,slotselect,logical,first_stage_mount
product     /product     erofs ro wait,slotselect,logical,first_stage_mount
product     /product     ext4  ro wait,slotselect,logical,first_stage_mount
vendor      /vendor      erofs ro wait,slotselect,logical,first_stage_mount
vendor      /vendor      ext4  ro wait,slotselect,logical,first_stage_mount
vendor_dlkm /vendor_dlkm erofs ro wait,slotselect,logical,first_stage_mount
vendor_dlkm /vendor_dlkm ext4  ro wait,slotselect,logical,first_stage_mount
odm_dlkm    /odm_dlkm    erofs ro wait,slotselect,logical,first_stage_mount
odm_dlkm    /odm_dlkm    ext4  ro wait,slotselect,logical,first_stage_mount
system_dlkm /system_dlkm erofs ro wait,slotselect,logical,first_stage_mount
system_dlkm /system_dlkm ext4  ro wait,slotselect,logical,first_stage_mount

# Keep ODM out of PartitionManager (mounted read-only by
# system/bin/beforemodules.sh before touch modules probe on the reference).

# BootControl resolves the BCB through Recovery's fstab. This enables no
# OrangeFox image-flash, storage, backup, or wipe target for the entry.
/dev/block/by-name/misc /misc emmc defaults defaults

/dev/block/by-name/metadata /metadata f2fs noatime,nosuid,nodev,discard wait,check,formattable,first_stage_mount

# userdata must carry the device's real FBE flags; copy the options/flags
# verbatim from the stock first-stage fstab or decryption breaks.
# Source: fstab.mt6991 line 87 (official platform ramdisk).
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt wait,check,formattable,quota,latemount,resize,reservedsize=128m,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,fsverity

# rescue is mounted as /cache (drop when the device has no rescue partition).
/dev/block/by-name/rescue /cache ext4 noatime,nosuid,nodev,noauto_da_alloc,discard wait,check,formattable,nofail

# Keep vendor_boot as the only explicit image-flash target. PartitionManager
# creates /super separately for logical-partition handling; all raw
# boot-chain and firmware partitions stay hidden from this inventory.
# persist is NOT listed here — it lives in system/etc/fstab.pd2415.persist.
/dev/block/by-name/vendor_boot /vendor_boot emmc defaults slotselect,flashimg
